[Unit]
Description=FastAPI RAG Backend Application Service
After=network.target

[Service]
User=root
WorkingDirectory=/var/www/chat_base/rag-backend
ExecStart=/var/www/chat_base/rag-backend/.venv311/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 2
Restart=always
RestartSec=3
EnvironmentFile=/var/www/chat_base/rag-backend/.env
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
