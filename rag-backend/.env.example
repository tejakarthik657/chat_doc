# -----------------------------------------------------------------------------
# RAG Backend Environment Configuration (.env)
# -----------------------------------------------------------------------------

# 1. Environment & Auth Security
ENVIRONMENT=development
SECRET_KEY=dev-secret-key-change-in-prod
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 2. Database Connections
MONGODB_URL=mongodb://localhost:27017
DB_NAME=rag_db

# Qdrant Vector Database (Local disk storage by default)
QDRANT_PATH=./storage/qdrant_db

# Neo4j Graph Database (Optional fallback to dynamic agent graph if inactive)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=password

# 3. Primary LLM API Key (GROQ - Required for sub-second responses)
# Get key for free at: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# 4. Tier 2 OCR API Key (OCR.space - 25,000 req/mo Free Tier)
# Get key for free at: https://ocr.space/ocrapi (defaults to 'helloworld' if left empty)
OCR_SPACE_API_KEY=helloworld

# 5. Tier 3 Google Vision API Credentials (Optional - 1,000 req/mo Free)
# Set absolute path to your Google Service Account JSON key or API key
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\google-vision-key.json
# GOOGLE_VISION_API_KEY=your_google_vision_api_key

# 6. Storage & Upload Limits
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=50
MAX_DOCS=100
MAX_QUESTIONS_PER_DAY=1000

# 7. Durable PDF object storage (required for production uploads)
# Create this in the Cloudinary dashboard and keep it secret.
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
