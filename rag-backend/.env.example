# Copy this to .env and fill in your values

# MongoDB Atlas (Free M0 tier)
MONGODB_URL=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=rag_db

# Auth
SECRET_KEY=your-super-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080  # 7 days

# Storage paths (local disk)
STORAGE_DIR=./storage
MODEL_CACHE_DIR=./models

# Embedding model (downloaded automatically on first run)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Local LLM - download the GGUF file manually
# Download from: https://huggingface.co/TheBloke/TinyLlama-1.1B-Chat-v1.0-GGUF
# File: tinyllama-1.1b-chat-v1.0.Q4_K_M.gguf
LOCAL_LLM_PATH=./models/tinyllama-1.1b-chat-v1.0.Q4_K_M.gguf
LOCAL_LLM_TYPE=llama

# RAG Config
RETRIEVAL_TOP_K=6
CONTEXT_TOP_K=3
SIMILARITY_THRESHOLD=0.35
CHUNK_SIZE=700
CHUNK_OVERLAP=100

# Free-tier limits per user
MAX_STORAGE_MB=50
MAX_DOCS=5
MAX_QUESTIONS_PER_DAY=50
