# Copy this to .env and fill in your values

# ── Environment ────────────────────────────────────────────────────────────────
ENVIRONMENT=development

# ── MongoDB Atlas (Free M0 tier) ──────────────────────────────────────────────
MONGODB_URL=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=rag_db

# ── Auth ──────────────────────────────────────────────────────────────────────
SECRET_KEY=your-super-secret-key-change-this-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Storage paths (local disk) ────────────────────────────────────────────────
STORAGE_DIR=./storage
MODEL_CACHE_DIR=./models

# ── Embedding model ───────────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── Reranker model ────────────────────────────────────────────────────────────
RERANKER_MODEL=BAAI/bge-reranker-base

# ── Local LLM (optional fallback) ─────────────────────────────────────────────
LOCAL_LLM_PATH=./models/tinyllama-1.1b-chat-v1.0.Q4_K_M.gguf
LOCAL_LLM_TYPE=llama

# ── RAG Config ────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=25
CONTEXT_TOP_K=8
SIMILARITY_THRESHOLD=0.25
CHUNK_SIZE=1500
CHUNK_OVERLAP=200

# ── Feature Flags ─────────────────────────────────────────────────────────────
CONTEXTUAL_ENABLED=True
CRAG_ENABLED=True

# ── Free-tier limits ──────────────────────────────────────────────────────────
MAX_STORAGE_MB=50
MAX_DOCS=5
MAX_QUESTIONS_PER_DAY=50

# ── Groq API (free cloud LLM) ─────────────────────────────────────────────────
GROQ_API_KEY=your-groq-api-key

# ── Qdrant Vector Database ────────────────────────────────────────────────────
QDRANT_URL=https://your-cluster.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key
USE_QDRANT_SERVER=true

# ── Redis (task broker + cache) ───────────────────────────────────────────────
REDIS_URL=redis://:redis_password@localhost:6379/0

# ── Celery Task Queue ─────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://:redis_password@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:redis_password@localhost:6379/2

# ── Groq API Resilience ───────────────────────────────────────────────────────
GROQ_RATE_LIMIT_RPM=30
GROQ_RETRY_MAX_ATTEMPTS=4
GROQ_CIRCUIT_BREAKER_THRESHOLD=5
GROQ_CIRCUIT_BREAKER_RECOVERY_TIMEOUT=60

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://your-app.vercel.app,https://your-custom-domain.com

# ── Upload Limits ─────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=50
